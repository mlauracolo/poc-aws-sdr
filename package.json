{
	"name": "poc-aws-sdr",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.30.0",
	"scripts": {
		"build:domain": "pnpm --filter @sdr/domain build",
		"build:library": "pnpm run build:domain && pnpm --filter @sdr/library build",
		"build:integration": "pnpm run build:domain && pnpm --filter @sdr/integration build",
		"build:lambda": "pnpm run build:domain && pnpm --filter @sdr/integration build:lambda",
		"build:lambda:all": "pnpm run build:domain && pnpm --filter @sdr/integration build:lambda:all",
		"check:lambda": "pnpm run build:domain && pnpm --filter @sdr/integration check:lambda",
		"test:lambda": "pnpm --filter @sdr/integration test:lambda",
		"prepare": "husky",
		"commitlint": "npx --no-install commitlint --config ./node_modules/@pormeldev/pormel-commit-conventions/dist/commitlint.config.js",
		"build": "pnpm run build:domain && pnpm --filter @sdr/library build && pnpm --filter @sdr/integration build",
		"build:docker": "docker build --secret id=npmrc,src=.npmrc --secret id=github_pat,env=GITHUB_PAT -f packages/store/Dockerfile -t poc-aws-sdr .",
		"build:lambda:docker": "docker build --secret id=npmrc,src=.npmrc --secret id=github_pat,env=GITHUB_PAT -f packages/integration/Dockerfile.lambda -t poc-aws-sdr-lambda .",
		"start:dev": "pnpm --filter @sdr/library start:dev",
		"start:prod": "pnpm --filter @sdr/library start:prod",
		"test:unit": "jest --detectOpenHandles --passWithNoTests",
		"test:watch": "jest --watch",
		"test:application": "jest 'packages/**/application/__tests__/**/*.spec.ts'",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"lint": "biome ci",
		"lint:staged": "biome check --staged",
		"format:verify": "biome format .",
		"format:write": "biome format --write .",
		"lint:verify": "biome lint .",
		"lint:write": "biome lint --write .",
		"check:verify": "biome check .",
		"check:write": "biome check --write",
		"@pormeldev/axis-module-logging-edenor": "2.0.0",
		"@pormeldev/pormel-commit-conventions": "1.8.0-rc",
		"@pormeldev/axis-common-lib": "2.0.0",
		"@pormeldev/axis-logpublisher-edenor": "2.0.0",
		"@pormeldev/axis-module-health": "2.1.0",
		"@pormeldev/axis-module-users": "2.0.1",
		"@pormeldev/axis-nestjs-common": "3.0.0",
		"@pormeldev/axis-service-auditing": "2.0.0",
		"@pormeldev/axis-service-authorization": "2.0.0",
		"@pormeldev/axis-service-authorization-awsvp": "2.0.0",
		"@pormeldev/axis-service-cache": "2.0.0",
		"@pormeldev/axis-service-cache-redis": "2.0.0",
		"@pormeldev/axis-service-database": "2.0.0",
		"@pormeldev/axis-service-database-typeorm": "2.0.0",
		"@pormeldev/axis-service-filestorage": "2.0.0",
		"@pormeldev/axis-service-filestorage-awss3": "2.0.0",
		"@pormeldev/axis-service-httpclient": "2.0.0",
		"@pormeldev/axis-service-httpclient-axios": "2.0.0",
		"@pormeldev/axis-service-logger": "3.0.0",
		"@pormeldev/axis-service-logger-pino": "3.0.0",
		"@pormeldev/axis-service-sequence": "2.0.0",
		"@pormeldev/axis-service-sequence-typeorm": "3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@nestjs/cli": "^11.0.21",
		"@pormeldev/pormel-commit-conventions": "1.7.0-rc",
		"@swc/cli": "^0.7.10",
		"@swc/core": "^1.15.33",
		"@swc/jest": "^0.2.39",
		"@types/aws-lambda": "^8.10.161",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.0.0",
		"@types/qs": "^6.15.1",
		"commitizen": "^4.3.1",
		"commitlint": "21.0.1",
		"cz-conventional-changelog": "^3.3.0",
		"esbuild": "^0.28.0",
		"husky": "9.1.7",
		"jest": "^30.4.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.22.3",
		"typescript": "^5.9.3"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"pormel": {
		"commitLint": {
			"ticketPrefixes": [
				"SDR"
			],
			"debug": false
		}
	},
	"dependencies": {
		"@pormeldev/axis-nestjs-common": "^3.2.0",
		"@pormeldev/axis-service-database-typeorm": "^2.0.1",
		"oracledb": "^6.10.0"
	}
}
